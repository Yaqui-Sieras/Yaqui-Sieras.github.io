---
// src/pages/contacto.astro
import MainLayout from '@layouts/MainLayout.astro';

interface Repository {
  id: number;
  name: string;
  description: string | null;
  html_url: string;
  stargazers_count: number;
  fork: boolean;
  language: string | null;
  homepage: string | null; // URL del sitio o demo en vivo si existe
}

const USERNAME = 'Yaqui-Sieras';
const SORT_BY = 'updated'; // Puedes cambiarlo a 'created', 'pushed', etc.
const PER_PAGE = 25; // Número máximo de repositorios por página
const response = await fetch(`https://api.github.com/users/${USERNAME}/repos?sort=${SORT_BY}&per_page=${PER_PAGE}`);
const allRepos: Repository[] = await response.json();

// Opcional: Filtrar forks o repos sin descripción
const repos = allRepos.filter((repo) => !repo.fork);

const title_page: string = 'Proyectos'
const description_page: string = 'Estos son algunos de mis proyectos más recientes.'
const image_page: string = 'https://placehold.co/1200x630/1d1d1d/F0F0F0/png?text=Proyectos+Preview&font=roboto'

---

<MainLayout
  titlePage={title_page}
  description={description_page}
  image={image_page}
>
  <h1>Mis Proyectos</h1>
  <p>Estos son algunos de mis proyectos más recientes. <span>Cant.: {repos.length}</span></p>
  <div class="grid">
    {repos.map((repo) => (
      <article>
        <h2><a href={repo.html_url} target="_blank" rel="noopener noreferrer">{repo.name}</a></h2>
        <p>{repo.description || 'Sin descripción'}</p>

        <div class="metadata">
          {repo.language && <span>Language: {repo.language}</span>}
          <span>⭐ {repo.stargazers_count}</span>
          {repo.homepage && <a href={repo.homepage} target="_blank">Demo en vivo</a>}
        </div>
      </article>
    ))}
  </div>
</MainLayout>