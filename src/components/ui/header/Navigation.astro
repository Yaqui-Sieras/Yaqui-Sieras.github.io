---
// src/components/ui/header/Navigation.astro
import { NAV_ITEMS } from '@/constants/routes';
import Link from '@components/ui/common/Link.astro';

const currentPath = Astro.url.pathname;

---

<nav class="navigation">
  {NAV_ITEMS.map((data) => {
    const isExternal = data.href.startsWith("https://");

    const targetPathname = isExternal ? new URL(data.href).pathname : data.href;

    const isActive = targetPathname === '/'
      ? currentPath === '/'
      : currentPath.startsWith(targetPathname);

    return (
      <Link
        href={data.href}
        target={data.target}
        class:list={[
          'nav_item',
          { 'nav_item--active': isActive }
        ]}
      >
        {data.label}
      </Link>
    );
  })}
</nav>

<style>
  .navigation {
    height: inherit;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  :global(.nav_item) {
    height: inherit;
    font-size: 1.1rem;
    font-weight: 600;
    color: #e0e0e0;
    padding: 0.5rem 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;

    &:hover,
    &.nav_item--active {
      color: #00d26a;
    }
  }
</style>