---
//
import Informacion from '@components/home/hero/presentacion/Informacion.astro';

import Image from '@/components/ui/common/Image.astro';
import miFoto from '@assets/imgs/yo.png';
---

<article class="presentacion">
  <Informacion />
  <Image
    src={miFoto}
    alt="Foto de Yaqui Sieras"
    width={250}
    height={250}
    variant="card"
    blur="15px"
    brightness={0.7}
  />
</article>

<style>
  .presentacion {
    width: 90%;
    padding: 1rem;
    border-radius: 2rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    gap: 1rem;
  }
</style>
